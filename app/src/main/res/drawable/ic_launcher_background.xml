<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景底色深邃黑曜蓝渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#030712" />
                <item android:offset="1.0" android:color="#0B1528" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心径向青蓝科技光晕 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="54">
                <item android:offset="0.0" android:color="#3300F0FF" />
                <item android:offset="0.7" android:color="#0D00F0FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 极弱极简刻度微环 -->
    <path
        android:strokeColor="#1A38BDF8"
        android:strokeWidth="0.8"
        android:pathData="M54,12 A42,42 0 1,1 53.99,12" />
</vector>
