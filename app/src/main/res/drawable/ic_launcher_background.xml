<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景底色深邃渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#0A1128" />
                <item android:offset="0.5" android:color="#101F42" />
                <item android:offset="1.0" android:color="#080D1A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心径向科技光晕 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="50">
                <item android:offset="0.0" android:color="#5900B4D8" />
                <item android:offset="0.7" android:color="#0D0077B6" />
                <item android:offset="1.0" android:color="#0003045E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 背景科技装饰环 -->
    <path
        android:strokeColor="#261E3A8A"
        android:strokeWidth="0.8"
        android:pathData="M54,10 A44,44 0 1,1 53.99,10" />
    <path
        android:strokeColor="#330284C7"
        android:strokeWidth="0.6"
        android:pathData="M54,16 A38,38 0 1,1 53.99,16" />
