<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景带 24dp 圆角矩形裁切 -->
    <path android:pathData="M24,0 h60 a24,24 0 0,1 24,24 v60 a24,24 0 0,1 -24,24 h-60 a24,24 0 0,1 -24,-24 v-60 a24,24 0 0,1 24,-24 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#030712" />
                <item android:offset="1.0" android:color="#0B1528" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心径向青蓝科技光晕 -->
    <path android:pathData="M24,0 h60 a24,24 0 0,1 24,24 v60 a24,24 0 0,1 -24,24 h-60 a24,24 0 0,1 -24,-24 v-60 a24,24 0 0,1 24,-24 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="54">
                <item android:offset="0.0" android:color="#3300F0FF" />
                <item android:offset="0.7" android:color="#0D00F0FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 极弱极简刻度微环 -->
    <path
        android:strokeColor="#1A38BDF8"
        android:strokeWidth="0.8"
        android:pathData="M54,12 A42,42 0 1,1 53.99,12" />

    <!-- Android 倾斜天线 (左) -->
    <path
        android:strokeColor="#10B981"
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:pathData="M42,30 L34,17" />

    <!-- Android 倾斜天线 (右) -->
    <path
        android:strokeColor="#10B981"
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:pathData="M66,30 L74,17" />

    <!-- 右上方投屏无线广播弧线 -->
    <path
        android:strokeColor="#D938BDF8"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:pathData="M62,42 A15,15 0 0,1 77,57" />

    <!-- 投屏无线通信微节点 -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M62,54.2 a2.8,2.8 0 1,1 -0.01,0 Z" />

    <!-- 核心命令行提示符 '>' (大字号、加粗、全彩渐变、圆头) -->
    <path
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,37 L52,54 L31,71">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="37"
                android:endX="52"
                android:endY="71">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.4" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 终端光标水平基线 '_' (加粗、绿色、圆头) -->
    <path
        android:strokeColor="#10B981"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:pathData="M56,71 L77,71" />
</vector>
