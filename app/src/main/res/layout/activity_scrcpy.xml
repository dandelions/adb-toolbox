<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 投屏主画面区 -->
    <FrameLayout
        android:id="@+id/flScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 硬件解码低延迟 SurfaceView -->
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="visible" />

        <!-- 截图兼容模式 ImageView -->
        <ImageView
            android:id="@+id/ivScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Screen Stream"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- 加载中指示器 -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="visible" />

        <!-- 状态提示文字 -->
        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="24dp"
            android:textColor="#ECEFF1"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 顶部 Toolbar (全屏时可隐藏) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="#99000000"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"
        app:title="屏幕镜像"
        app:titleTextColor="#FFFFFF">

        <!-- 右侧顶部快捷按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnToolbarFullscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全屏"
                android:src="@drawable/ic_nav_fullscreen"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnToolbarSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:src="@drawable/ic_nav_settings"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 诊断信息状态条（位于 Toolbar 下方） -->
    <LinearLayout
        android:id="@+id/layoutDiagBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="?attr/actionBarSize"
        android:background="#B3121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <View
            android:id="@+id/vStatusIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#FFB300" />

        <TextView
            android:id="@+id/tvDiagText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="正在初始化投屏通道..."
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnQuickSwitchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="切换模式"
            android:textColor="#80D8FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnQuickAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="音频选项"
            android:textColor="#C5CAE9"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnQuickWake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="唤醒屏幕"
            android:textColor="#FFD54F"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 虚拟按键控制导航栏 (支持底部、顶部、左侧、右侧停靠或隐藏) -->
    <FrameLayout
        android:id="@+id/navBarWrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal">

        <LinearLayout
            android:id="@+id/navBarContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#B31E1E1E"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/ic_nav_back"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="主页"
                android:src="@drawable/ic_nav_home"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnRecent"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="多任务"
                android:src="@drawable/ic_nav_recent"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnHeadset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="虚拟耳机（静音被控端外放）"
                android:src="@drawable/ic_nav_headset"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnScreenOff"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="熄屏操作"
                android:src="@drawable/ic_nav_power"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="投屏设置"
                android:src="@drawable/ic_nav_settings"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

    <!-- 浮动悬浮球（尺寸缩小一倍精致圆球，支持全屏/隐藏控制栏时自由拖动与快速唤起菜单） -->
    <ImageView
        android:id="@+id/fabQuickMenu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.85"
        android:background="@drawable/bg_floating_ball"
        android:contentDescription="控制菜单"
        android:elevation="6dp"
        android:padding="6dp"
        android:src="@drawable/ic_nav_more"
        android:visibility="gone"
        app:tint="#FFFFFF" />

</FrameLayout>
